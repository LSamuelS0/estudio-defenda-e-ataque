{
  "name": "estudio-defenda-e-ataque",
  "productName": "Estúdio Defenda e Ataque",
  "version": "1.0.0",
  "description": "Estúdio de personagens, animações, equipamentos e efeitos do jogo Defenda e Ataque",
  "main": "main.js",
  "author": "Lucas Samuel",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "testar": "node testes/rodar.js",
    "montar:windows": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.lsamuels.estudio-defenda-e-ataque",
    "productName": "Estúdio Defenda e Ataque",
    "directories": { "output": "../dist" },
    "files": ["**/*", "!testes/**"],
    "win": { "icon": "icone.png", "artifactName": "Estudio-Defenda-e-Ataque-${version}-${arch}-${target}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Estúdio Defenda e Ataque", "language": "1046" },
    "portable": { "artifactName": "Estudio-Defenda-e-Ataque-${version}-portatil.exe" }
  }
}
