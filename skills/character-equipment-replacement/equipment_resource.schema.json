{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EquipmentResource",
  "type": "object",
  "required": [
    "id",
    "name",
    "slot",
    "coverage_regions",
    "anchors",
    "deformation_profile",
    "validation_status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "slot": {
      "type": "string"
    },
    "compatible_archetypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage_regions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "draw_order": {
      "type": "string"
    },
    "body_mask": {
      "type": "string"
    },
    "deformation_profile": {
      "enum": [
        "flexible",
        "moderate",
        "rigid_low_deform",
        "rigid_preserve_volume",
        "cloth_secondary_motion",
        "custom"
      ]
    },
    "directional_assets": {
      "type": "object",
      "properties": {
        "front": {
          "type": "string"
        },
        "back": {
          "type": "string"
        },
        "left": {
          "type": "string"
        },
        "right": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "animation_overrides": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "occlusion_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_status": {
      "enum": [
        "draft",
        "needs_review",
        "validated",
        "production"
      ]
    }
  },
  "additionalProperties": true
}
